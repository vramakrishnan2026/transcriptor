{
  "manifest_version": 3,
  "name": "Transcripter",
  "version": "1.3.0",
  "description": "Export the full transcript of a Teams/Stream meeting recording as a clean text file.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Export transcript",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Vinay",
  "background": {
    "service_worker": "background.js"
  }
}