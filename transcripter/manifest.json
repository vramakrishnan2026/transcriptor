{
  "manifest_version": 3,
  "name": "Transcripter",
  "version": "1.4.0",
  "description": "Export the full transcript of a Teams/Stream meeting recording, and build a key-moments report with screenshots.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.sharepoint.com/*"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Transcripter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Vinay",
  "background": {
    "service_worker": "background.js"
  }
}
